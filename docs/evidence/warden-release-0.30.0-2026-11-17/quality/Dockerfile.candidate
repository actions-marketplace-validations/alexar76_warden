# WARDEN 0.30.0 for HISTOR: the running production image (histor-histor:warden-0.29.0-prod = sha256:fbf1b2e906eb…,
# WARDEN 0.29.0) with its vendored WARDEN replaced by the release archive of 49e1c6b39 (83b7b8086fb00358…) and the
# WARDEN source of the same commit where the trusted recipe puts it. Nothing of HISTOR's own code changes.
FROM histor-histor:warden-0.29.0-prod
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/
COPY src/ /opt/warden-source/src/
LABEL skopos.source.commit="49e1c6b39b6c5ac392a8466792c9469a2f37e9b0" \
      aicom.histor.overlay="warden-030-prod-20261118" \
      org.aimarket.release.candidate="warden-0.30.0" \
      org.aimarket.release.tarball-sha256="83b7b8086fb00358e97c3e6966fbe9043782367e5fce9da835ead29665c7ea90" \
      org.aimarket.release.warden-build="73c618fbc7e75ce7d506d17a7c5b061e8ad9fd75fb81b728fc5829f6a255218d"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.30.0') process.exit(1)"

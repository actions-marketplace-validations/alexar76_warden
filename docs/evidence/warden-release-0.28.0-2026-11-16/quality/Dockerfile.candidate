# WARDEN 0.28.0 for HISTOR: the running production image (histor-histor:crawlretry-20261116 = sha256:fce417bc5ef6…,
# WARDEN 0.27.0) with its vendored WARDEN replaced by the release archive of 3e11a0697 (f5cfaa70b30ba85…) and the
# WARDEN source of the same commit where the trusted recipe puts it. Nothing of HISTOR's own code changes.
FROM histor-histor:crawlretry-20261116
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/
COPY src/ /opt/warden-source/src/
LABEL skopos.source.commit="3e11a06972732e4de5b55ba261b5373474df27fd" \
      aicom.histor.overlay="warden-028-prod-20261116" \
      org.aimarket.release.candidate="warden-0.28.0" \
      org.aimarket.release.tarball-sha256="f5cfaa70b30ba85dce6b48c7c5f82696cdc68cd0e6219ac65c117c2065adb958" \
      org.aimarket.release.warden-build="25e77ff9c307fd9bf65296985b8137e831d6ee6a6d966e33b53c326f6fbf41c7"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.28.0') process.exit(1)"

      org.aimarket.release.warden-build="5654940ad487dd66cabcf7b703f96cd03ea7dd2cc1e1a0890269b70db0253936"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.36.0') process.exit(1)"

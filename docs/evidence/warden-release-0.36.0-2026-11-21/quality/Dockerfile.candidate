# WARDEN 0.36.0 for HISTOR: histor-histor:subregistry-20261121 (= sha256:02011e75cf644c5164126f6ea03503d627787586203c6b3f1d87675b0e50fd65, the image HISTOR production runs since
# 2026-11-21 10:27Z) with its vendored WARDEN replaced by the release archive of bcd830766
# (28544c38d4cc4862ec97015cd0f8b3f262e7b2f8b8a8d60d7c7c1bac62250d2e) and the WARDEN source of the same commit where the
# trusted recipe puts it. Nothing of HISTOR's own code changes. Built on admin-vps from the same image ID.
FROM histor-histor:subregistry-20261121
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/

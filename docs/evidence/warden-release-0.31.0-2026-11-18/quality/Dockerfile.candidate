# WARDEN 0.31.0 for HISTOR: the running production image (histor-histor:warden-0.30.0-prod = sha256:d75d0fe1ff10…,
# WARDEN 0.30.0, MOMUS live since 2026-11-18 08:02Z) with its vendored WARDEN replaced by the release archive of
# 3fa99ee26 (4927bf1825cc6409) and the WARDEN source of the same commit where the trusted recipe puts it. Nothing of
# HISTOR's own code changes. Built on admin-vps from the same image ID, as the live receipt names it.
FROM histor-histor:warden-0.30.0-prod
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/

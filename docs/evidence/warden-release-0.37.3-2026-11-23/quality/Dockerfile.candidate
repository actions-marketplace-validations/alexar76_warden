# WARDEN 0.37.3 for HISTOR: addresses-20261122 (= sha256:c44951f59d00dd8d0a13d2d5d12093a945526d0e70a193b1e49c51d2a1959f90,
# production since the addresses rollout; still running WARDEN 0.37.1) with vendored WARDEN replaced by the
# release archive of 0.37.3 (sha256 6b0d1e8c…) and matching source under /opt/warden-source/src.
# Nothing of HISTOR's own code changes.
FROM histor-histor:addresses-20261122
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/
COPY src/ /opt/warden-source/src/
LABEL skopos.source.commit="496284972fb4db7bddcd485317c4879b5a211ba7" \
      aicom.histor.overlay="warden-0373-prod-20261123" \
      org.aimarket.release.candidate="warden-0.37.3" \
      org.aimarket.release.tarball-sha256="6b0d1e8c3d79b4c00189f2208b8a6a55047e86e5f904b7a3d1c424fa145bdda6" \
      org.aimarket.release.warden-build="8f685dd818a52e09b0b9a029bf25ec333edda8355499570905017d23e87bc6b2"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.37.3') process.exit(1)"

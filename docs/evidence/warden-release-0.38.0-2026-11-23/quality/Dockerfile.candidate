LABEL skopos.source.commit="9443d42e64323dca17db17b36144f257e616cf04" \
      aicom.histor.overlay="warden-0380-prod-20261123" \
      org.aimarket.release.candidate="warden-0.38.0" \
      org.aimarket.release.tarball-sha256="b4b647989dc28ba480c2fa17d55072e3bc27026528f8543f286f22386d06c8f6" \
      org.aimarket.release.warden-build="cbb3a54fa345fca64aff9c2d54349c3fe9dee2b4e1b429fd6df161efd29c110b"
USER 65532:65532
RUN node --input-type=module -e "import {readFileSync} from 'node:fs'; const p=JSON.parse(readFileSync('/app/scanner/node_modules/@aimarket/warden/package.json','utf8')); if(p.name!=='@aimarket/warden'||p.version!=='0.38.0') process.exit(1)"

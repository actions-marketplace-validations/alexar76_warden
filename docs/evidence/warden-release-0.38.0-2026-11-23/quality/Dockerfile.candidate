# with vendored WARDEN replaced by the release archive of 0.38.0 (sha256 b4b64798…)
# and matching source under /opt/warden-source/src. Nothing of HISTOR's own code changes.
FROM histor-histor:warden-0.37.3-prod
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
COPY package/ /app/scanner/node_modules/@aimarket/warden/

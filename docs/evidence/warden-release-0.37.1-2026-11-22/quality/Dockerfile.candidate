# archive of 6f2963a4b (f413cdd216c6b8100fafd8874e72ed147b43454738be219ee2d73c9949e7d703) and the WARDEN source of the same commit where the
# trusted recipe puts it. Nothing of HISTOR's own code changes. Built on admin-vps from the same image ID.
FROM histor-histor:faq-20261122
USER 0:0
RUN rm -rf /app/scanner/node_modules/@aimarket/warden /opt/warden-source/src
